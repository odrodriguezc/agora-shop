<%
content_for :title, "Admin - Code Coverage"
%>

<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Code Coverage Report</h1>
      <p class="mt-2 text-gray-600">View test coverage statistics and run test suite</p>
    </div>
    <div>
      <%= button_to "Run Tests", admin_test_coverage_run_tests_path, 
          method: :post,
          class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors",
          data: { 
            confirm: "This will run the entire test suite. It may take a few minutes. Continue?",
            disable_with: "Running tests..."
          } %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg">
      <%= notice %>
    </div>
  <% end %>

    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
    <div class="p-6 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Coverage Report</h2>
      <p class="mt-1 text-sm text-gray-600">
        Generated by SimpleCov. Click "Run Tests" above to update with the latest results.
      </p>
    </div>
    
    <div class="p-6">
      <div class="text-center">
        <%= link_to admin_test_coverage_report_path, 
            class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
          View Detailed Coverage Report
        <% end %>
        
        <p class="mt-4 text-sm text-gray-500">
          View comprehensive test coverage statistics and file-by-file analysis
        </p>
      </div>
    </div>
  </div>
</div>
<%
content_for :title, "File Coverage Details"
%>

<div class="container mx-auto px-4 py-8">
  <!-- File header -->
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm mb-6">
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">
            <%= @file_data['filename'].gsub('/app/', '') %>
          </h2>
          <p class="text-sm text-gray-600 mt-1">
            Line-by-line coverage analysis
          </p>
        </div>
        <div class="text-right">
          <div class="text-3xl font-bold <%= @file_data['covered_percent'] >= 90 ? 'text-green-600' : @file_data['covered_percent'] >= 80 ? 'text-yellow-600' : 'text-red-600' %>">
            <%= '%.1f' % @file_data['covered_percent'] %>%
          </div>
          <div class="text-sm text-gray-600">Coverage</div>
        </div>
      </div>
    </div>
    
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="text-2xl font-bold text-green-600">
            <%= @file_data['covered_lines'] %>
          </div>
          <div class="text-sm text-gray-600">Lines Covered</div>
        </div>
        
        <div class="text-center">
          <div class="text-2xl font-bold text-red-600">
            <%= @file_data['lines_of_code'] - @file_data['covered_lines'] %>
          </div>
          <div class="text-sm text-gray-600">Lines Uncovered</div>
        </div>
        
        <div class="text-center">
          <div class="text-2xl font-bold text-gray-600">
            <%= @file_data['lines_of_code'] %>
          </div>
          <div class="text-sm text-gray-600">Total Lines</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Uncovered Lines Summary -->
  <% uncovered_lines = [] %>
  <% @coverage_lines.each_with_index { |coverage, index| uncovered_lines << (index + 1) if coverage == 0 } %>
  <% if uncovered_lines.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg shadow-sm mb-6">
      <div class="p-6">
        <h3 class="text-lg font-medium text-red-900 mb-3">Uncovered Lines</h3>
        <p class="text-sm text-red-700 mb-3">
          <%= uncovered_lines.length %> lines need test coverage:
        </p>
        <div class="flex flex-wrap gap-2">
          <% uncovered_lines.each do |line_num| %>
            <a href="#line-<%= line_num %>" 
               class="inline-flex items-center px-2 py-1 text-xs font-medium bg-red-100 text-red-800 rounded hover:bg-red-200 transition-colors">
              Line <%= line_num %>
            </a>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Source code with coverage -->
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
    <div class="p-6 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900">Source Code</h3>
      <div class="mt-2 flex items-center space-x-4 text-sm">
        <div class="flex items-center">
          <div class="w-3 h-3 bg-green-500 rounded mr-2"></div>
          <span>Covered</span>
        </div>
        <div class="flex items-center">
          <div class="w-3 h-3 bg-red-500 rounded mr-2"></div>
          <span>Uncovered</span>
        </div>
        <div class="flex items-center">
          <div class="w-3 h-3 bg-gray-300 rounded mr-2"></div>
          <span>Not Executable</span>
        </div>
      </div>
    </div>
    
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <tbody class="bg-white">
          <% @source_lines.each_with_index do |line, index| %>
            <% line_number = index + 1 %>
            <% coverage = @coverage_lines[index] %>
            <% Rails.logger.info("[Coverage] Line #{line_number}: #{coverage}") %>
            <% 
              # Determine line status with robust handling
              case coverage
              when nil
                line_class = "bg-gray-50"  # Not executable
                status_class = "bg-gray-300"
                hit_count = ""
              when 0
                line_class = "bg-red-50"   # Uncovered
                status_class = "bg-red-500"
                hit_count = "0"
              when Integer
                line_class = "bg-green-50" # Covered
                status_class = "bg-green-500"
                hit_count = coverage.to_s
              else
                line_class = "bg-yellow-50" # Unexpected data
                status_class = "bg-yellow-500"
                hit_count = "?"
              end
            %>
            
            <tr class="<%= line_class %> hover:bg-opacity-75" id="line-<%= line_number %>">
              <!-- Line number -->
              <td class="px-3 py-1 text-right text-xs font-mono text-gray-500 w-16 border-r border-gray-200">
                <a href="#line-<%= line_number %>" class="hover:text-gray-700">
                  <%= line_number %>
                </a>
              </td>
              
              <!-- Coverage indicator -->
              <td class="px-2 py-1 w-12 text-center">
                <% unless coverage.nil? %>
                  <div class="flex items-center justify-center">
                    <div class="w-2 h-2 <%= status_class %> rounded-full mr-2"></div>
                    <span class="text-xs font-mono text-gray-600">
                      <%= hit_count %>
                    </span>
                  </div>
                <% end %>
              </td>
              
              <!-- Source code -->
              <td class="px-4 py-1 font-mono text-sm whitespace-pre-wrap overflow-x-auto <%= coverage == 0 ? 'text-red-800' : coverage && coverage > 0 ? 'text-green-800' : 'text-gray-700' %>">
                <%= line.chomp.gsub(' ', '&nbsp;').html_safe %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Navigation -->
  <div class="mt-8 text-center space-x-4">
    <%= link_to "← Back to Coverage Report", admin_coverage_report_path, 
        class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= link_to "← Back to Admin Coverage", admin_coverage_path, 
        class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
</div>

<style>
  /* Ensure proper spacing for code display */
  .font-mono {
    font-family: 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace;
  }
  
  /* Improve readability for long lines */
  td:last-child {
    word-break: break-all;
    white-space: pre-wrap;
  }
</style>
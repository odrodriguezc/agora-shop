<%# 
  Locals:
  - product: Product object (required)
  - variant: Symbol (:thumb, :small, :medium, :large) default: :thumb
  - show_all_images: Boolean, default: false
%>
<% variant ||= :thumb %>
<% show_all_images ||= false %>

<div id="<%= dom_id product %>" class="space-y-3">
  <div>
    <strong class="block font-medium mb-1 text-gray-700">Title:</strong>
    <p class="text-gray-900"><%= product.title %></p>
  </div>
  
  <% if product.has_images? %>
    <div>
      <strong class="block font-medium mb-2 text-gray-700">Images:</strong>
      <div class="flex flex-wrap gap-2">
        <% if show_all_images %>
          <%# Show all images in the specified variant %>
          <% product.images.each do |image| %>
            <% if image.representable? %>
              <%= image_tag image.variant(variant), class: "border rounded object-cover #{variant == :thumb ? 'w-20 h-20' : 'w-full max-w-md'}" %>
            <% end %>
          <% end %>
        <% else %>
          <%# Show only primary image in thumb variant %>
          <% if product.primary_image.representable? %>
            <%= image_tag product.send("primary_#{variant}"), class: "border rounded object-cover w-20 h-20" %>
          <% end %>
          <% if product.images_count > 1 %>
            <div class="w-20 h-20 border rounded flex items-center justify-center bg-gray-50 text-gray-600 text-sm">
              +<%= product.images_count - 1 %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <strong class="block font-medium text-gray-700">Price:</strong>
      <p class="text-lg font-semibold text-gray-900"><%= number_to_currency(product.price) %></p>
    </div>
    <div>
      <strong class="block font-medium text-gray-700">Stock:</strong>
      <p class="text-gray-900"><%= product.stock_quantity %></p>
    </div>
  </div>

  <div>
    <strong class="block font-medium mb-1 text-gray-700">Description:</strong>
    <p class="text-gray-600 text-sm line-clamp-2"><%= product.description %></p>
  </div>

  <div class="flex flex-wrap gap-2 text-sm">
    <span class="px-2 py-1 bg-gray-100 rounded"><strong>SKU:</strong> <%= product.sku %></span>
    <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded"><%= product.status.humanize %></span>
    <% if product.category %>
      <span class="px-2 py-1 bg-purple-100 text-purple-800 rounded"><%= product.category.name %></span>
    <% end %>
  </div>
</div>
